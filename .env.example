# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env

# Django
SECRET_KEY=django-insecure-troque-esta-chave-em-producao
DEBUG=True

# Banco de dados (configurado automaticamente pelo docker-compose)
DB_NAME=varrevila
DB_USER=varrevila_user
DB_PASSWORD=varrevila_pass
DB_HOST=db
DB_PORT=5432

# Identidade institucional
# Lidas por config/settings.py e injetadas nos templates pelo context processor
# core.context_processors.instituicao. INSTITUICAO_NOME é usada também pelo
# entrypoint.sh, no banner de inicialização.
INSTITUICAO_NOME=Varre Vila
# INSTITUICAO_SUBTITULO=Limpeza Comunitária
# INSTITUICAO_SLOGAN=Movimento Popular de Limpeza Urbana em São Paulo
# INSTITUICAO_EMAIL=contato@varrevila.org
# INSTITUICAO_FACEBOOK=https://www.facebook.com/varrevila/
# INSTITUICAO_ANO_FUNDACAO=2018
# INSTITUICAO_APROVA_1=Fiocruz
# INSTITUICAO_APROVA_2=Prefeitura de São Paulo
# INSTITUICAO_APROVA_3=SESC SP
